# Generated (tsc/esbuild output of src/) — never hand-edited, regenerated by
# `npm run build`, which is wired as a `pre*` step on start/dist/dist:zip/
# dist:dir/refresh-app. Mirrors the same exclusion in the "Generate GitHub
# package" export (main.ts's GITHUB_GITIGNORE).
/main.js
/preload.js
/renderer/app.js

