node_modules/
dist/
Shippable/
/data/

# Settings -> Export App State dumps (main.ts's export-app-state handler,
# written to the portable root) — a debug snapshot, not repo content.
/dts-app-state_*.txt

# Obsidian vault — Claude-maintained project notes/documentation, replacing
# most of CLAUDE.md's old bulk (see CLAUDE.md itself, now a short pointer
# into this vault). Local-only by design, not shared via git.
/notes/

# Tauri port exploration (tauri-port/) — Rust build output and the
# Tauri CLI's own npm install, both regenerable via `npx tauri dev`/`build`.
tauri-port/src-tauri/target/
tauri-port/src-tauri/gen/

# Mobile port (Capacitor/Android) — a separate, not-yet-committed subproject
# with its own node_modules + Android build tree; excluded from the desktop
# app's own git history for now (per explicit decision, 2026-09-18).
/mobile/

# Generated (tsc/esbuild output of src/) — never hand-edited, regenerated by
# `npm run build`, which is wired as a `pre*` step on start/dist/dist:zip/
# dist:dir/refresh-app.
/main.js
/preload.js
/renderer/app.js

# Root build (electron-builder --dir output, copied here by refresh-app —
# see scripts/refresh-portable-dev.js). Tied to Electron's currently-bundled
# runtime files; if a future Electron upgrade adds/removes one, check
# `git status` after the next refresh-app and add it here if needed.
/Dataset Tag Studio.exe
/LICENSE.electron.txt
/LICENSES.chromium.html
/README.txt
/chrome_100_percent.pak
/chrome_200_percent.pak
