{
  "name": "comfy-bridge",
  "version": "1.0.0",
  "description": "Standalone desktop interface for a ComfyUI instance, built on Dataset Manager Studio's SynthDat Overseer generation workflow — no dataset, no accept/reject, just Generate.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json --noEmit && esbuild src/renderer/app.ts --bundle --outfile=renderer/app.js",
    "build:shared": "esbuild src/renderer/shared/index.ts --bundle --format=iife --global-name=BridgeShared --outfile=mobile/www/shared.js && node scripts/copy-shared-css.js",
    "build": "npm run build:main && npm run build:shared && npm run build:renderer",
    "prestart": "npm run build",
    "start": "electron .",
    "predist:zip": "npm run build",
    "dist:zip": "electron-builder --win zip --config.directories.output=Shippable",
    "predist:dir": "npm run build",
    "dist:dir": "electron-builder --dir",
    "prerefresh-app": "npm run build",
    "refresh-app": "electron-builder --dir && node scripts/refresh-portable-dev.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.local.comfybridge",
    "productName": "Comfy Bridge",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/ws/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "compression": "normal",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": ["zip"],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.23.1": true
  }
}
