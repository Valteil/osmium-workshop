{
  "name": "osmium-workshop",
  "version": "1.9.5",
  "description": "Local dataset tag editor for AI training images (built around Anima and booru-tag models), packaged as a desktop app.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json --noEmit && esbuild src/renderer/index.ts --bundle --outfile=renderer/app.js",
    "build:tag-categories": "node scripts/build-tag-categories.js",
    "build:wiki-data": "node scripts/build-wiki-data.js",
    "build": "npm run build:main && npm run build:renderer",
    "prestart": "npm run build",
    "start": "electron .",
    "predist": "npm run build",
    "dist": "electron-builder",
    "predist:zip": "npm run build",
    "dist:zip": "electron-builder --win zip --config.directories.output=Shippable",
    "predist:dir": "npm run build",
    "dist:dir": "electron-builder --dir",
    "prerefresh-app": "npm run build",
    "build:theme-icons": "electron scripts/render-theme-icons.js",
    "refresh-app": "electron-builder --dir && node scripts/refresh-portable-dev.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.local.osmiumworkshop",
    "productName": "Osmium Workshop",
    "files": [
      "main.js",
      "preload.js",
      "wd14-local.js",
      "comfy-local.js",
      "trainflow.js",
      "local-comfy/**/*",
      "comfy-core.js",
      "bucket-local.js",
      "bucket-core.js",
      "http-download.js",
      "renderer/**/*",
      "node_modules/ws/**/*",
      "node_modules/onnxruntime-node/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/theme-icons/*.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "build/icon.ico",
      "build/theme-icons/*.ico",
      "local-comfy/**/*"
    ],
    "afterPack": "scripts/after-pack.js",
    "compression": "normal",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.23.1": true,
    "onnxruntime-node@1.30.0": true
  },
  "dependencies": {
    "onnxruntime-node": "^1.30.0",
    "ws": "^8.21.3"
  }
}
